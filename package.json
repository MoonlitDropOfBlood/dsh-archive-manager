{
  "name": "@duke-dsh-plugins/dsh-archive-manager",
  "version": "1.3.6",
  "description": "Archive manager for DeepSeek Harness: group archived sessions by project, newest-first, with search, restore and delete.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoonlitDropOfBlood/dsh-archive-manager.git"
  },
  "homepage": "https://github.com/MoonlitDropOfBlood/dsh-archive-manager",
  "bugs": { "url": "https://github.com/MoonlitDropOfBlood/dsh-archive-manager/issues" },
  "publishConfig": { "access": "public" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "session", "archive"],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check typert.host.js"
  }
}
